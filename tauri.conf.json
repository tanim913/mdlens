{
  "build": {
    "distDir": "ui",
    "devPath": "ui",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "mdlens",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true
      },
      "shell": {
        "open": "^(https?://|mailto:)"
      },
      "protocol": {
        "asset": true,
        "assetScope": []
      },
      "window": {
        "close": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "startDragging": true
      }
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost https: data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "mdlens",
        "width": 960,
        "height": 740,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false,
        "fileDropEnabled": true
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "dev.tanim.mdlens",
      "targets": [
        "deb",
        "nsis"
      ],
      "category": "Utility",
      "shortDescription": "Light Markdown viewer",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ],
      "deb": {
        "desktopTemplate": "mdlens.desktop"
      }
    }
  }
}
