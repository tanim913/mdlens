{
  "name": "mdlens",
  "version": "0.3.0",
  "description": "A light Markdown viewer: opens .md files rendered, one key to the source",
  "main": "main.js",
  "license": "MIT",
  "author": "tanim913 <42853370+tanim913@users.noreply.github.com>",
  "homepage": "https://github.com/tanim913/mdlens",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --linux deb",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "desktopName": "mdlens.desktop",
  "build": {
    "appId": "dev.tanim.mdlens",
    "productName": "mdlens",
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "ui/**",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "icons/128x128@2x.png",
      "synopsis": "Light Markdown viewer",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown",
        "inode/directory"
      ],
      "executableName": "mdlens",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown",
          "description": "Markdown document",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "artifactName": "mdlens-${version}-setup.exe"
    },
    "afterPack": "build-scripts/adhoc-sign.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "mdlens-${version}-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown",
          "description": "Markdown document",
          "role": "Viewer"
        }
      ]
    }
  }
}
